{
  "name": "@through-line/store-postgres",
  "version": "0.2.0",
  "description": "Throughline production durable store backed by pg (Postgres).",
  "license": "MIT",
  "keywords": ["durable-execution", "postgres", "postgresql", "workflow", "journal", "throughline"],
  "author": "Jagadesh Varma Nadimpalli",
  "homepage": "https://github.com/jagguvarma15/throughline#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jagguvarma15/throughline.git",
    "directory": "packages/store-postgres"
  },
  "bugs": "https://github.com/jagguvarma15/throughline/issues",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check src"
  },
  "dependencies": {
    "@through-line/core": "workspace:*",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@through-line/testing": "workspace:*",
    "@types/pg": "^8.11.10"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
