{
  "name": "@through-line/adapters-llm",
  "version": "0.3.172",
  "description": "Throughline BYO-LLM helpers: wrap a user-provided model call in a durable step.",
  "license": "MIT",
  "keywords": ["durable-execution", "llm", "ai-agents", "byo-llm", "throughline"],
  "author": "Jagadesh Varma Nadimpalli",
  "homepage": "https://github.com/jagguvarma15/throughline#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jagguvarma15/throughline.git",
    "directory": "packages/adapters-llm"
  },
  "bugs": "https://github.com/jagguvarma15/throughline/issues",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check src"
  },
  "dependencies": {
    "@through-line/core": "workspace:*"
  },
  "devDependencies": {
    "@through-line/store-sqlite": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
