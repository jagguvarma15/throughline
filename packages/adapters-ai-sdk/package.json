{
  "name": "@through-line/adapters-ai-sdk",
  "version": "0.2.179",
  "description": "Durable Vercel AI SDK adapter: journal every model call and tool execution as a Throughline step.",
  "license": "MIT",
  "keywords": [
    "durable-execution",
    "ai-sdk",
    "vercel-ai-sdk",
    "ai-agents",
    "tool-calling",
    "exactly-once",
    "throughline"
  ],
  "author": "Jagadesh Varma Nadimpalli",
  "homepage": "https://github.com/jagguvarma15/throughline#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jagguvarma15/throughline.git",
    "directory": "packages/adapters-ai-sdk"
  },
  "bugs": "https://github.com/jagguvarma15/throughline/issues",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check src"
  },
  "dependencies": {
    "@through-line/core": "workspace:*"
  },
  "peerDependencies": {
    "ai": "^7.0.0"
  },
  "devDependencies": {
    "@through-line/store-sqlite": "workspace:*",
    "@through-line/testing": "workspace:*",
    "ai": "^7.0.14"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
