{
  "name": "@through-line/store-sqlite",
  "version": "0.3.0",
  "description": "Throughline default durable store backed by better-sqlite3.",
  "license": "MIT",
  "keywords": [
    "durable-execution",
    "sqlite",
    "better-sqlite3",
    "workflow",
    "journal",
    "throughline"
  ],
  "author": "Jagadesh Varma Nadimpalli",
  "homepage": "https://github.com/jagguvarma15/throughline#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jagguvarma15/throughline.git",
    "directory": "packages/store-sqlite"
  },
  "bugs": "https://github.com/jagguvarma15/throughline/issues",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check src"
  },
  "dependencies": {
    "@through-line/core": "workspace:*",
    "better-sqlite3": "^12.11.1"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/context-async-hooks": "^2.0.0",
    "@opentelemetry/sdk-trace-base": "^2.0.0",
    "@through-line/testing": "workspace:*",
    "@types/better-sqlite3": "^7.6.11"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
