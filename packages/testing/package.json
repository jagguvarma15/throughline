{
  "name": "@through-line/testing",
  "version": "0.2.179",
  "description": "Throughline test harness: fault-injection store, store/engine conformance suites, record/replay.",
  "license": "MIT",
  "keywords": [
    "durable-execution",
    "testing",
    "fault-injection",
    "chaos",
    "golden-trace",
    "conformance",
    "throughline"
  ],
  "author": "Jagadesh Varma Nadimpalli",
  "homepage": "https://github.com/jagguvarma15/throughline#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jagguvarma15/throughline.git",
    "directory": "packages/testing"
  },
  "bugs": "https://github.com/jagguvarma15/throughline/issues",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check src"
  },
  "dependencies": {
    "@through-line/core": "workspace:*"
  },
  "peerDependencies": {
    "vitest": ">=2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
